<Window x:Class="MinimalMVVM.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="420" Width="300">

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ConvertTextCommand}"/>
    </Window.InputBindings>

    <StackPanel Margin="10">
        <Label Foreground="Blue">Text To Convert</Label>
        <TextBox Text="{Binding SomeText, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

        <Label Foreground="Blue">History</Label>
        <ListBox ItemsSource="{Binding History}" Height="180" Margin="5"/>

        <Button Command="{Binding ConvertTextCommand}" Margin="5" Height="30">Convert</Button>

        <Separator Margin="5"/>
        <Button Click="SwitchViewModel_Click" Background="LightGray" Margin="5" Height="30">
            Switch to LowerCase Mode
        </Button>
    </StackPanel>
</Window>