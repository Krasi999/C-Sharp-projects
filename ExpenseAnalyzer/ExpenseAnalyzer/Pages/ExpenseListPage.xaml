<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpenseAnalyzer.Pages.ExpenseListPage"
             Title="Expenses">

    <CollectionView x:Name="expenseList" 
                    SelectionMode="Single"
                    SelectionChanged="OnExpenseSelected">

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10" BackgroundColor="#F8F9FA" BorderColor="#DEE2E6">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{Binding Category}" 
                               FontAttributes="Bold" 
                               FontSize="18" 
                               TextColor="#333333"/>

                        <Label Text="{Binding Amount, StringFormat='{0:F2} euro.'}" 
                               FontSize="16" 
                               TextColor="DarkGreen" 
                               FontAttributes="Bold"/>

                        <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}" 
                               FontSize="12" 
                               TextColor="Gray"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>
</ContentPage>