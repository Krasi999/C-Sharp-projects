<ContentPage
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="ExpenseAnalyzer.Pages.AddExpensePage"
 Title="Choose Category">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Button Text="Food" Clicked="FoodClicked"/>
        <Button Text="Transport" Clicked="TransportClicked"/>
        <Button Text="Rent" Clicked="RentClicked"/>
        <Button Text="Leasing" Clicked="LeasingClicked"/>
        <Button Text="Entertainment" Clicked="EntertainmentClicked"/>
        <Button Text="Other Expenses" Clicked="OtherClicked"/>

    </VerticalStackLayout>

</ContentPage>