<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        xmlns:local2 = "clr-namespace:UI.Components"
        mc:Ignorable="d"
        Title="List of all students" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local2:StudentsList Grid.Row="0" x:Name="studentsList" Padding="2" />

        <Button Grid.Row="1" Content="Open Logger" Click="OpenLogger_Click" 
            Width="120" Height="30" Margin="10" HorizontalAlignment="Right" />
    </Grid>
</Window>